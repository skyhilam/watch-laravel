<?xml version="1.0" encoding="UTF-8"?>
<!--
    One configuration for PHPUnit 9.5 to 13. Only attributes that every one of
    those schemas accepts are used here. cacheDirectory and failOnNotice exist
    from PHPUnit 10 only, so CI passes them on the command line for the rows
    that run PHPUnit 10 or newer.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true">
    <testsuites>
        <testsuite name="Watch Laravel">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
