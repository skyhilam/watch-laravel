{
    "name": "skyhilam/watch-laravel",
    "description": "Fail-open capture package for the Watch request explorer. Redacts before data leaves the source app.",
    "type": "library",
    "keywords": [
        "laravel",
        "monitoring",
        "observability",
        "logging",
        "request"
    ],
    "homepage": "https://github.com/skyhilam/watch-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "skyhilam",
            "homepage": "https://github.com/skyhilam"
        }
    ],
    "support": {
        "issues": "https://github.com/skyhilam/watch-laravel/issues",
        "source": "https://github.com/skyhilam/watch-laravel"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^8.83 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.5.10 || ^10.5 || ^11.5.50 || ^12.5.8 || ^13.0"
    },
    "suggest": {
        "ext-pcntl": "Lets watch:agent stop cleanly on SIGTERM/SIGINT."
    },
    "autoload": {
        "psr-4": {
            "Watch\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Watch\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Watch\\Laravel\\WatchServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
